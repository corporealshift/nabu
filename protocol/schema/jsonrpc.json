{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://rho.dev/schema/jsonrpc.json",
  "title": "rho JSON-RPC 2.0 message",
  "oneOf": [
    { "$ref": "#/$defs/request" },
    { "$ref": "#/$defs/notification" },
    { "$ref": "#/$defs/success" },
    { "$ref": "#/$defs/failure" }
  ],
  "$defs": {
    "id": { "oneOf": [{ "type": "integer" }, { "type": "string" }] },
    "method": {
      "type": "string",
      "enum": [
        "rho.hello",
        "rho.session.list",
        "rho.workspace.browse",
        "rho.workspace.create_directory",
        "rho.session.create",
        "rho.session.send_prompt",
        "rho.session.events_after",
        "rho.session.subscribe",
        "rho.session.unsubscribe",
        "rho.session.interrupt",
        "rho.session.stop",
        "rho.session.resume",
        "rho.session.state",
        "rho.session.set_goal",
        "rho.session.clear_goal",
        "rho.session.set_option",
        "rho.session.update_tasks",
        "rho.session.compact",
        "rho.session.archive",
        "rho.session.restore",
        "rho.session.stats",
        "rho.usage",
        "rho.stats",
        "rho.stats.calls",
        "rho.device.register",
        "rho.device.unregister",
        "rho.session.set_status",
        "rho.session.event",
        "rho.session.delta",
        "rho.session.thinking",
        "rho.rpc.permission.request",
        "rho.rpc.ui.ask"
      ]
    },
    "request": {
      "type": "object",
      "required": ["jsonrpc", "id", "method"],
      "properties": {
        "jsonrpc": { "const": "2.0" },
        "id": { "$ref": "#/$defs/id" },
        "method": { "$ref": "#/$defs/method" },
        "params": { "type": "object" }
      }
    },
    "notification": {
      "type": "object",
      "required": ["jsonrpc", "method"],
      "not": { "required": ["id"] },
      "properties": {
        "jsonrpc": { "const": "2.0" },
        "method": { "type": "string", "enum": ["rho.session.event", "rho.session.delta", "rho.session.thinking"] },
        "params": { "type": "object" }
      }
    },
    "success": {
      "type": "object",
      "required": ["jsonrpc", "id", "result"],
      "properties": {
        "jsonrpc": { "const": "2.0" },
        "id": { "$ref": "#/$defs/id" },
        "result": { "type": ["object", "null"] }
      }
    },
    "failure": {
      "type": "object",
      "required": ["jsonrpc", "id", "error"],
      "properties": {
        "jsonrpc": { "const": "2.0" },
        "id": { "oneOf": [{ "$ref": "#/$defs/id" }, { "type": "null" }] },
        "error": {
          "type": "object",
          "required": ["code", "message"],
          "properties": {
            "code": {
              "type": "integer",
              "enum": [-32700, -32600, -32601, -32602, -32603, -32001, -32002, -32003, -32004, -32005, -32006, -32007, -32008]
            },
            "message": { "type": "string" },
            "data": {
              "type": "object",
              "properties": {
                "name": {
                  "type": "string",
                  "enum": [
                    "parse_error", "invalid_request", "method_not_found", "invalid_params", "internal_error",
                    "rho_session_not_found", "rho_invalid_transition", "rho_permission_denied",
                    "rho_already_resolved", "rho_cursor_unknown", "rho_protocol_mismatch",
                    "rho_unauthorized", "rho_workspace_untrusted"
                  ]
                }
              }
            }
          }
        }
      }
    }
  }
}
